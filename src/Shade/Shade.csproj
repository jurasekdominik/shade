<Project Sdk="Microsoft.NET.Sdk">
  <!-- The design shade: tokens, theme and shared controls for Avalonia desktop apps. -->
  <PropertyGroup>
    <RootNamespace>Shade</RootNamespace>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <PackageId>Shade</PackageId>
    <Description>Dark desktop design system for Avalonia: colour roles, type scale, theme and shared controls.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <AvaloniaResource Include="Assets\**\*.ttf" />
    <InternalsVisibleTo Include="Shade.Gallery" />
    <!-- the public API, listed in PublicAPI.*.txt: a change to it fails the build until the list says so -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt;PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
