<!-- Shade's controls in XAML, bound to a view model: the build fails if a control can't be made or a property isn't
     there; the run checks that the values flow both ways. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shade="using:Shade"
             xmlns:t="using:Shade.Tests"
             x:Class="Shade.Tests.Bound"
             x:DataType="t:Vm">
  <StackPanel>
    <shade:Switch x:Name="Toggle" On="{Binding Flag}" />
    <shade:Tick x:Name="Box" State="{Binding Ticked}" />
    <shade:Field x:Name="NameField" Text="{Binding Name}" />
    <shade:ListField x:Name="Recipients" Text="{Binding Recipients}" Hint="Add a recipient" />
    <shade:SearchField x:Name="Find" Text="{Binding Query}" />
    <shade:Progress x:Name="Bar" Value="{Binding Share}" Label="Uploading" />
    <shade:StateToggle x:Name="State" On="{Binding Flag}" />
    <shade:SummaryCards x:Name="Cards" Items="{Binding Cards}" Detailed="True" />
    <shade:ActionButton x:Name="Save" Content="{Binding ActionText}" Kind="{Binding ActionKind}" Command="{Binding Save}" />
    <shade:IconButton x:Name="ExportAction" Icon="{Binding ActionIcon}" Command="{Binding Save}" />
    <shade:Capsule x:Name="PresetAction" Content="{Binding ActionText}" Icon="{Binding ActionIcon}" />
    <shade:MultiChoice x:Name="PeoplePicker" Selected="{Binding SelectedPeople}" Items="{Binding People}" EmptyText="Everyone" Label="People" />
    <shade:ChoiceButton x:Name="Choice" Current="{Binding Pick}" />
    <shade:AccentPicker x:Name="Picker" Label="Theme colour" Value="{Binding Accent}" />
    <shade:DateField x:Name="Day" Value="{Binding Day}" />
    <shade:DateRangeField x:Name="Span" Start="{Binding Day}" End="{Binding Until}" />
    <shade:EditableTable x:Name="Sheet" Sorting="{Binding Flag}" Design="{Binding Designing}" ValueSize="14" CanResize="False" CanEditFooter="False" />
    <shade:ModeSwitch x:Name="Modes" Value="{Binding Mode}" />
    <shade:Masonry x:Name="Blocks" MinColumn="200" MaxColumns="2" />
  </StackPanel>
</UserControl>
