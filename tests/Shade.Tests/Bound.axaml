<!-- Shade's controls in XAML, bound to a view model: the build fails if a control can't be made or a property isn't
     there; the run checks that the values flow both ways. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shade="using:Shade"
             xmlns:t="using:Shade.Tests"
             x:Class="Shade.Tests.Bound"
             x:DataType="t:Vm">
  <StackPanel>
    <shade:Switch x:Name="Toggle" IsChecked="{Binding Flag}" />
    <shade:Tick x:Name="Box" IsChecked="{Binding Ticked}" />
    <shade:Field x:Name="NameField" Text="{Binding Name}" />
    <shade:ListField x:Name="Recipients" Text="{Binding Recipients}" Hint="Add a recipient" />
    <shade:SearchField x:Name="Find" Text="{Binding Query}" />
    <shade:Progress x:Name="Bar" Value="{Binding Share}" Label="Uploading" />
    <shade:StateToggle x:Name="State" IsChecked="{Binding Flag}" />
    <shade:SummaryCards x:Name="Cards" Items="{Binding Cards}" Detailed="True" />
    <shade:ActionButton x:Name="Save" Content="{Binding ActionText}" Kind="{Binding ActionKind}" Command="{Binding Save}" />
    <shade:IconButton x:Name="ExportAction" Icon="{Binding ActionIcon}" Command="{Binding Save}" />
    <shade:Capsule x:Name="PresetAction" Content="{Binding ActionText}" Icon="{Binding ActionIcon}" />
    <shade:MultiChoice x:Name="PeoplePicker" Selected="{Binding SelectedPeople}" Items="{Binding People}" EmptyText="Everyone" Label="People" />
    <shade:SearchChoice x:Name="EmployeePicker" ItemsSource="{Binding Employees}" DisplayMemberBinding="{Binding Name}" SearchMemberBinding="{Binding SearchText}" SelectedValueBinding="{Binding Id}" SelectedValue="{Binding EmployeeId}" PlaceholderText="Choose employee" />
    <shade:ChoiceButton x:Name="Choice" Current="{Binding Pick}" Items="{Binding People}" />
    <shade:TickGrid x:Name="ShortChoices" Items="{Binding People}" Picked="{Binding ShortPicks}" />
    <shade:PairTable x:Name="Pairs" Entries="{Binding PairRows}" CaseSensitive="False" KeyHint="Name" ValueHint="Value" />
    <shade:FilterChip x:Name="Chip" Content="{Binding Name}" IsChecked="{Binding Flag}" Command="{Binding Save}" />
    <shade:Tag x:Name="FileTag" Text="{Binding Name}" Removable="True" RemoveCommand="{Binding Save}" />
    <shade:HostPortField x:Name="Address" PlaceholderText="{Binding Name}" DefaultPort="8080" />
    <shade:SuggestionField x:Name="Suggestions" Items="{Binding People}" ApplySelection="False" PlaceholderText="{Binding Name}" />
    <shade:NavigationButtons x:Name="History" CanGoBack="{Binding Flag}" BackCommand="{Binding Save}" />
    <shade:StatusBadge x:Name="Badge" Text="{Binding Name}" Kind="busy" />
    <shade:TableDesigner x:Name="Designer" Locked="{Binding Designing}" EmptyText="{Binding Name}" />
    <shade:ColorGrid x:Name="ColourHelper" Value="{Binding SwatchColour}" />
    <shade:AccentPicker x:Name="Picker" Label="Theme colour" Value="{Binding Accent}" />
    <shade:DateField x:Name="Day" Value="{Binding Day}" />
    <shade:DateRangeField x:Name="Span" Start="{Binding Day}" End="{Binding Until}" />
    <shade:EditableTable x:Name="Sheet" PaperDimensionsPlacement="{Binding PaperPlacement}" ConstrainToPaper="{Binding ConstrainToPaper}" PaperFormat="{Binding PaperFormat}" PaperLandscape="{Binding PaperLandscape}" CustomPaperSize="{Binding PaperDimensions}" ShowColumnEditor="{Binding Flag}" Sorting="{Binding Flag}" Design="{Binding Designing}" ValueSize="14" CanResize="False" CanEditFooter="False" ToolbarActions="EditColumns, AddColumn" ToolbarPlacement="Bottom" AddRowsPlacement="Top" />
    <shade:ModeSwitch x:Name="Modes" Value="{Binding Mode}" />
    <shade:Masonry x:Name="Blocks" MinColumn="200" MaxColumns="2" />
  </StackPanel>
</UserControl>
